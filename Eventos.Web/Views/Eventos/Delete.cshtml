@model Eventos.Web.ViewModels.EventoResumen

@{
    ViewData["Title"] = "Eliminar evento";
}

<h1>Eliminar evento</h1>
<p>El evento dejará de aparecer en los listados activos. Sus inscripciones se conservarán.</p>
<partial name="_Detalle" model="Model" />
<form asp-action="Delete" asp-route-id="@Model.Evento.Id" method="post">
    <button class="btn btn-danger">Confirmar eliminación</button>
    <a asp-action="Index">Volver</a>
</form>
